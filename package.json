{
  "name": "cf-manager",
  "version": "1.0.0",
  "description": "",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "prepare": "bun lefthook install",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check:types": "tsc --noEmit",
    "check:dups": "bun run check:jsinspect && bun run check:jscpd",
    "check:jsinspect": "jsinspect -t 50 --ignore \"node_modules|dist|supabase|docs|tests\" ./src",
    "check:jscpd": "jscpd --config=./jscpd.json ./src",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov",
    "check": "bun run check:types && bun run lint && bun run check:dups"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/bun": "^1.3.11",
    "@types/node": "^25.5.2",
    "jscpd": "^4.0.8",
    "jsinspect-plus": "^3.1.3",
    "lefthook": "^2.1.4",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {}
}
